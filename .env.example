PVE_HOST=proxmox.example.local
PVE_PORT=8006
PVE_TOKEN_ID=interns@pve!vmlab
PVE_TOKEN_SECRET=replace-with-token-secret
# Optional password auth; when set, it is preferred for vncwebsocket.
PVE_USER=
PVE_PASSWORD=
PVE_VERIFY_SSL=false
PVE_NODE=pve
TEMPLATE_VMID=9000
# Optional multi-template allowlist (overrides TEMPLATE_VMID when set):
# TEMPLATES=9000:Ubuntu 22.04,9001:Debian 12
CLONE_VMID_MIN=100
CLONE_VMID_MAX=999
CLONE_FULL=false
CLONE_STORAGE=
CLONE_POOL=
CLONE_NAME_PREFIX=intern
MAX_VMS_PER_USER=1
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_PROVIDER=local
# FreeIPA / LDAP authentication settings (when AUTH_PROVIDER=freeipa or AUTH_PROVIDER=ldap)
FREEIPA_SERVER=ipa.example.local
FREEIPA_PORT=636
FREEIPA_USE_SSL=true
FREEIPA_START_TLS=false
FREEIPA_VERIFY_SSL=false
FREEIPA_BASE_DN=dc=example,dc=local
# FREEIPA_USER_BASE_DN defaults to cn=users,cn=accounts,$FREEIPA_BASE_DN
# FREEIPA_GROUP_BASE_DN defaults to cn=groups,cn=accounts,$FREEIPA_BASE_DN
# Optional service bind DN & password for user lookup. If unset, direct user bind template is used.
# FREEIPA_BIND_DN=uid=binduser,cn=sysaccounts,cn=etc,dc=example,dc=local
# FREEIPA_BIND_PASSWORD=bindpassword
# FREEIPA_USER_FILTER=(uid={username})
# FREEIPA_USER_DN_TEMPLATE=uid={username},cn=users,cn=accounts,dc=example,dc=local
# Optional admin group (e.g. admins or full DN cn=admins,cn=groups,cn=accounts,dc=example,dc=local)
# FREEIPA_ADMIN_GROUP=admins
FREEIPA_AUTO_CREATE_USER=false
LOG_LEVEL=INFO
