PVE_HOST=proxmox.example.local
PVE_PORT=8006
PVE_TOKEN_ID=interns@pve!vmlab
PVE_TOKEN_SECRET=replace-with-token-secret
# Optional password auth; when set, it is preferred for vncwebsocket.
PVE_USER=
PVE_PASSWORD=
PVE_VERIFY_SSL=false
PVE_NODE=pve
TEMPLATE_VMID=9000
CLONE_VMID_MIN=100
CLONE_VMID_MAX=999
CLONE_FULL=false
CLONE_STORAGE=
CLONE_POOL=
CLONE_NAME_PREFIX=intern
MAX_VMS_PER_USER=1
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_PROVIDER=local
LOG_LEVEL=INFO
